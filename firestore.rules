rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isGenuineGoogleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOwner(userId) {
      return isGenuineGoogleUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isGenuineGoogleUser()
        && request.auth.token.email == 'kapilnarula27july@gmail.com';
    }

    // 3. Entity Validation Blueprints
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'providerId', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'providerId', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.providerId == 'google.com'
        && data.role == 'learner'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConnectionPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'kind', 'promptRef', 'title', 'body', 'createdAt'])
        && data.keys().hasOnly(['authorId', 'authorName', 'kind', 'promptRef', 'title', 'body', 'createdAt'])
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.kind in ['concept', 'perspective', 'challenge']
        && data.promptRef is string && data.promptRef.size() >= 1 && data.promptRef.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.body is string && data.body.size() <= 600
        && data.createdAt is timestamp;
    }

    function isValidLearnerWorkspace(data, userId) {
      return data.keys().hasAll(['ownerId', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'act2Pitch', 'act3StoryTitle', 'act3StoryBeats',
          'act4Observed', 'act4Missing', 'act4BeforeAfter',
          'act5CeoSolution', 'act7PitchName', 'act7PitchTagline', 'act7PitchAudience',
          'act7PitchUsps', 'act7PitchScript', 'act8Emotion', 'act8Situation',
          'act8Perspective', 'act8Response', 'act9Proposal', 'act10Theme', 'act10Notes',
          'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && (!('act2Pitch' in data) || (data.act2Pitch is string && data.act2Pitch.size() <= 1000))
        && (!('act3StoryTitle' in data) || (data.act3StoryTitle is string && data.act3StoryTitle.size() <= 160))
        && (!('act3StoryBeats' in data) || (data.act3StoryBeats is string && data.act3StoryBeats.size() <= 1500))
        && (!('act4Observed' in data) || (data.act4Observed is string && data.act4Observed.size() <= 500))
        && (!('act4Missing' in data) || (data.act4Missing is string && data.act4Missing.size() <= 500))
        && (!('act4BeforeAfter' in data) || (data.act4BeforeAfter is string && data.act4BeforeAfter.size() <= 800))
        && (!('act5CeoSolution' in data) || (data.act5CeoSolution is string && data.act5CeoSolution.size() <= 1000))
        && (!('act7PitchName' in data) || (data.act7PitchName is string && data.act7PitchName.size() <= 120))
        && (!('act7PitchTagline' in data) || (data.act7PitchTagline is string && data.act7PitchTagline.size() <= 160))
        && (!('act7PitchAudience' in data) || (data.act7PitchAudience is string && data.act7PitchAudience.size() <= 200))
        && (!('act7PitchUsps' in data) || (data.act7PitchUsps is string && data.act7PitchUsps.size() <= 600))
        && (!('act7PitchScript' in data) || (data.act7PitchScript is string && data.act7PitchScript.size() <= 1000))
        && (!('act8Emotion' in data) || (data.act8Emotion is string && data.act8Emotion.size() <= 300))
        && (!('act8Situation' in data) || (data.act8Situation is string && data.act8Situation.size() <= 300))
        && (!('act8Perspective' in data) || (data.act8Perspective is string && data.act8Perspective.size() <= 300))
        && (!('act8Response' in data) || (data.act8Response is string && data.act8Response.size() <= 500))
        && (!('act9Proposal' in data) || (data.act9Proposal is string && data.act9Proposal.size() <= 1200))
        && (!('act10Theme' in data) || (data.act10Theme is string && data.act10Theme.size() <= 200))
        && (!('act10Notes' in data) || (data.act10Notes is string && data.act10Notes.size() <= 1200))
        && data.updatedAt is timestamp;
    }

    function isValidLearnerProgress(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'xp', 'completedLevels', 'unlockedBadges',
          'wheelSpins', 'completedWheelPrompts', 'certificateId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'xp', 'completedLevels', 'unlockedBadges',
          'wheelSpins', 'completedWheelPrompts', 'certificateId', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.xp is number && data.xp >= 0 && data.xp <= 50000
        && data.completedLevels is list
        && data.completedLevels.size() <= 10
        && (data.completedLevels.size() == 0 || (data.completedLevels[0] is int && data.completedLevels[0] >= 1 && data.completedLevels[0] <= 10))
        && data.unlockedBadges is list
        && data.unlockedBadges.size() <= 20
        && (data.unlockedBadges.size() == 0 || (data.unlockedBadges[0] is string && data.unlockedBadges[0].size() <= 60))
        && data.wheelSpins is number && data.wheelSpins >= 0 && data.wheelSpins <= 5000
        && data.completedWheelPrompts is list
        && data.completedWheelPrompts.size() <= 50
        && (data.completedWheelPrompts.size() == 0 || (data.completedWheelPrompts[0] is string && data.completedWheelPrompts[0].size() <= 80))
        && data.certificateId is string && data.certificateId.size() >= 4 && data.certificateId.size() <= 64
        && data.updatedAt is timestamp;
    }

    function isValidAdvancedProgress(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'advXp', 'totalScoreSum', 'completedChallenges',
          'unlockedAdvBadges', 'advCertificateId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'advXp', 'totalScoreSum', 'completedChallenges',
          'unlockedAdvBadges', 'advCertificateId', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.advXp is number && data.advXp >= 0 && data.advXp <= 25000
        && data.totalScoreSum is number && data.totalScoreSum >= 0 && data.totalScoreSum <= 2500
        && data.completedChallenges is list
        && data.completedChallenges.size() <= 25
        && (data.completedChallenges.size() == 0 || (data.completedChallenges[0] is string && data.completedChallenges[0].size() <= 12))
        && data.unlockedAdvBadges is list
        && data.unlockedAdvBadges.size() <= 15
        && (data.unlockedAdvBadges.size() == 0 || (data.unlockedAdvBadges[0] is string && data.unlockedAdvBadges[0].size() <= 60))
        && data.advCertificateId is string && data.advCertificateId.size() >= 4 && data.advCertificateId.size() <= 64
        && data.updatedAt is timestamp;
    }

    function isValidAdvancedSubmission(data) {
      return data.keys().hasAll([
          'ownerId', 'authorName', 'challengeId', 'themeId',
          'promptUsed', 'imageDataUrl', 'answer1', 'answer2', 'answer3',
          'answer4', 'answer5', 'scareSummary', 'totalScore',
          'obsScore', 'reasonScore', 'creativityScore', 'actionScore',
          'commScore', 'feedback', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'authorName', 'challengeId', 'themeId',
          'promptUsed', 'imageDataUrl', 'answer1', 'answer2', 'answer3',
          'answer4', 'answer5', 'scareSummary', 'totalScore',
          'obsScore', 'reasonScore', 'creativityScore', 'actionScore',
          'commScore', 'feedback', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.challengeId is string && data.challengeId.size() >= 1 && data.challengeId.size() <= 12
        && data.themeId in ['products', 'values', 'abstract', 'placements', 'services']
        && data.promptUsed is string && data.promptUsed.size() <= 1400
        && data.imageDataUrl is string && data.imageDataUrl.size() <= 280000
        && data.answer1 is string && data.answer1.size() <= 1200
        && data.answer2 is string && data.answer2.size() <= 1200
        && data.answer3 is string && data.answer3.size() <= 1200
        && data.answer4 is string && data.answer4.size() <= 1200
        && data.answer5 is string && data.answer5.size() <= 1200
        && data.scareSummary is string && data.scareSummary.size() <= 1200
        && data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 100
        && data.obsScore is number && data.obsScore >= 0 && data.obsScore <= 20
        && data.reasonScore is number && data.reasonScore >= 0 && data.reasonScore <= 25
        && data.creativityScore is number && data.creativityScore >= 0 && data.creativityScore <= 20
        && data.actionScore is number && data.actionScore >= 0 && data.actionScore <= 20
        && data.commScore is number && data.commScore >= 0 && data.commScore <= 15
        && data.feedback is string && data.feedback.size() <= 800
        && data.updatedAt is timestamp;
    }

    function isValidShoppingProgress(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'authorName', 'authorEmail', 'shopXp', 'studiedExamples',
          'answeredMcqs', 'correctMcqs', 'hintUsedMcqs', 'mcqChoices',
          'roleplayDraft', 'roleplayScore', 'roleplayFeedback',
          'unlockedShopBadges', 'shopCertificateId', 'completedModule', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'authorName', 'authorEmail', 'shopXp', 'studiedExamples',
          'answeredMcqs', 'correctMcqs', 'hintUsedMcqs', 'mcqChoices',
          'roleplayDraft', 'roleplayScore', 'roleplayFeedback',
          'unlockedShopBadges', 'shopCertificateId', 'completedModule', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.authorEmail is string && data.authorEmail.size() <= 160
        && data.shopXp is number && data.shopXp >= 0 && data.shopXp <= 20000
        && data.studiedExamples is list && data.studiedExamples.size() <= 45
        && (data.studiedExamples.size() == 0 || (data.studiedExamples[0] is string && data.studiedExamples[0].size() <= 40))
        && data.answeredMcqs is list && data.answeredMcqs.size() <= 20
        && (data.answeredMcqs.size() == 0 || (data.answeredMcqs[0] is string && data.answeredMcqs[0].size() <= 20))
        && data.correctMcqs is list && data.correctMcqs.size() <= 20
        && (data.correctMcqs.size() == 0 || (data.correctMcqs[0] is string && data.correctMcqs[0].size() <= 20))
        && data.hintUsedMcqs is list && data.hintUsedMcqs.size() <= 20
        && (data.hintUsedMcqs.size() == 0 || (data.hintUsedMcqs[0] is string && data.hintUsedMcqs[0].size() <= 20))
        && data.mcqChoices is list && data.mcqChoices.size() <= 20
        && (data.mcqChoices.size() == 0 || (data.mcqChoices[0] is number && data.mcqChoices[0] >= -1 && data.mcqChoices[0] <= 3))
        && data.roleplayDraft is string && data.roleplayDraft.size() <= 1500
        && data.roleplayScore is number && data.roleplayScore >= 0 && data.roleplayScore <= 100
        && data.roleplayFeedback is string && data.roleplayFeedback.size() <= 800
        && data.unlockedShopBadges is list && data.unlockedShopBadges.size() <= 12
        && (data.unlockedShopBadges.size() == 0 || (data.unlockedShopBadges[0] is string && data.unlockedShopBadges[0].size() <= 60))
        && data.shopCertificateId is string && data.shopCertificateId.size() >= 4 && data.shopCertificateId.size() <= 64
        && data.completedModule is bool
        && data.updatedAt is timestamp;
    }

    function isValidCareerSkillsProgress(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'authorName', 'authorEmail', 'careerXp', 'studiedTopics',
          'answeredMcqs', 'correctMcqs', 'hintUsedMcqs', 'mcqChoices',
          'completedCategories', 'unlockedCareerBadges', 'careerCertificateId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'authorName', 'authorEmail', 'careerXp', 'studiedTopics',
          'answeredMcqs', 'correctMcqs', 'hintUsedMcqs', 'mcqChoices',
          'completedCategories', 'unlockedCareerBadges', 'careerCertificateId', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.authorEmail is string && data.authorEmail.size() <= 160
        && data.careerXp is number && data.careerXp >= 0 && data.careerXp <= 25000
        && data.studiedTopics is list && data.studiedTopics.size() <= 35
        && (data.studiedTopics.size() == 0 || (data.studiedTopics[0] is string && data.studiedTopics[0].size() <= 40))
        && data.answeredMcqs is list && data.answeredMcqs.size() <= 45
        && (data.answeredMcqs.size() == 0 || (data.answeredMcqs[0] is string && data.answeredMcqs[0].size() <= 20))
        && data.correctMcqs is list && data.correctMcqs.size() <= 45
        && (data.correctMcqs.size() == 0 || (data.correctMcqs[0] is string && data.correctMcqs[0].size() <= 20))
        && data.hintUsedMcqs is list && data.hintUsedMcqs.size() <= 45
        && (data.hintUsedMcqs.size() == 0 || (data.hintUsedMcqs[0] is string && data.hintUsedMcqs[0].size() <= 20))
        && data.mcqChoices is list && data.mcqChoices.size() <= 45
        && (data.mcqChoices.size() == 0 || (data.mcqChoices[0] is number && data.mcqChoices[0] >= -1 && data.mcqChoices[0] <= 3))
        && data.completedCategories is list && data.completedCategories.size() <= 3
        && (data.completedCategories.size() == 0 || data.completedCategories[0] in ['indianism', 'interview', 'gd'])
        && data.unlockedCareerBadges is list && data.unlockedCareerBadges.size() <= 12
        && (data.unlockedCareerBadges.size() == 0 || (data.unlockedCareerBadges[0] is string && data.unlockedCareerBadges[0].size() <= 60))
        && data.careerCertificateId is string && data.careerCertificateId.size() >= 4 && data.careerCertificateId.size() <= 64
        && data.updatedAt is timestamp;
    }

    function isValidMasterSkillsProgress(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'authorName', 'authorEmail', 'masterXp', 'studiedPlaybooks',
          'answeredMcqs', 'correctMcqs', 'hintUsedMcqs', 'mcqChoices',
          'completedTracks', 'unlockedMasterBadges', 'masterCertificateId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'authorName', 'authorEmail', 'masterXp', 'studiedPlaybooks',
          'answeredMcqs', 'correctMcqs', 'hintUsedMcqs', 'mcqChoices',
          'completedTracks', 'unlockedMasterBadges', 'masterCertificateId', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.authorEmail is string && data.authorEmail.size() <= 160
        && data.masterXp is number && data.masterXp >= 0 && data.masterXp <= 60000
        && data.studiedPlaybooks is list && data.studiedPlaybooks.size() <= 120
        && (data.studiedPlaybooks.size() == 0 || (data.studiedPlaybooks[0] is string && data.studiedPlaybooks[0].size() <= 40))
        && data.answeredMcqs is list && data.answeredMcqs.size() <= 160
        && (data.answeredMcqs.size() == 0 || (data.answeredMcqs[0] is string && data.answeredMcqs[0].size() <= 20))
        && data.correctMcqs is list && data.correctMcqs.size() <= 160
        && (data.correctMcqs.size() == 0 || (data.correctMcqs[0] is string && data.correctMcqs[0].size() <= 20))
        && data.hintUsedMcqs is list && data.hintUsedMcqs.size() <= 160
        && (data.hintUsedMcqs.size() == 0 || (data.hintUsedMcqs[0] is string && data.hintUsedMcqs[0].size() <= 20))
        && data.mcqChoices is list && data.mcqChoices.size() <= 160
        && (data.mcqChoices.size() == 0 || (data.mcqChoices[0] is number && data.mcqChoices[0] >= -1 && data.mcqChoices[0] <= 3))
        && data.completedTracks is list && data.completedTracks.size() <= 16
        && (data.completedTracks.size() == 0 || data.completedTracks[0] in [
          'aptitude', 'grammar', 'parts_of_speech', 'parts_of_grammar',
          'tenses', 'punctuation', 'idioms',
          'c_lang', 'cpp_lang', 'java_lang', 'python_lang', 'dsa',
          'excel', 'power_bi', 'dbms', 'cloud'
        ])
        && data.unlockedMasterBadges is list && data.unlockedMasterBadges.size() <= 12
        && (data.unlockedMasterBadges.size() == 0 || (data.unlockedMasterBadges[0] is string && data.unlockedMasterBadges[0].size() <= 60))
        && data.masterCertificateId is string && data.masterCertificateId.size() >= 4 && data.masterCertificateId.size() <= 64
        && data.updatedAt is timestamp;
    }

    function isValidSectionFeedback(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'authorEmail', 'sectionId', 'sectionLabel',
          'subTopic', 'category', 'rating', 'highlights', 'improvement',
          'status', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorId', 'authorName', 'authorEmail', 'sectionId', 'sectionLabel',
          'subTopic', 'category', 'rating', 'highlights', 'improvement',
          'status', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.authorEmail is string && data.authorEmail.size() >= 3 && data.authorEmail.size() <= 160
        && data.sectionId in [
          'journey', 'levels', 'wheel', 'shopping', 'career',
          'universe', 'advanced', 'final', 'achievements'
        ]
        && data.sectionLabel is string && data.sectionLabel.size() >= 1 && data.sectionLabel.size() <= 80
        && data.subTopic is string && data.subTopic.size() <= 100
        && data.category in [
          'content_depth', 'new_topic', 'ui_ux',
          'practice_problems', 'mentor_appreciation'
        ]
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.highlights is string && data.highlights.size() <= 400
        && data.improvement is string && data.improvement.size() >= 4 && data.improvement.size() <= 1000
        && data.status in ['new', 'reviewed', 'implemented']
        && data.adminNote is string && data.adminNote.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFinalAssessment(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'authorName', 'authorEmail', 'targetRole', 'collegeOrOrg',
          'status', 'startedAtMs', 'submittedAtMs', 'timeUsedSeconds', 'mcqAnswers',
          'c1a', 'c1b', 'c1c', 'c2a', 'c2b', 'c2c',
          'c3a', 'c3b', 'c3c', 'c4a', 'c4b', 'c4c',
          'c5a', 'c5b', 'c5c', 'capstoneScare',
          'mcqScore', 'caseScore', 'scareScore', 'totalXpAwarded',
          'percentageScore', 'passed', 'gradeTier',
          'finalCertificateId', 'lorVerificationId', 'executiveFeedback', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'authorName', 'authorEmail', 'targetRole', 'collegeOrOrg',
          'status', 'attemptCount', 'startedAtMs', 'submittedAtMs', 'timeUsedSeconds', 'mcqAnswers',
          'c1a', 'c1b', 'c1c', 'c2a', 'c2b', 'c2c',
          'c3a', 'c3b', 'c3c', 'c4a', 'c4b', 'c4c',
          'c5a', 'c5b', 'c5c', 'capstoneScare',
          'mcqScore', 'caseScore', 'scareScore', 'totalXpAwarded',
          'percentageScore', 'passed', 'gradeTier',
          'finalCertificateId', 'lorVerificationId', 'executiveFeedback', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.authorEmail is string && data.authorEmail.size() >= 3 && data.authorEmail.size() <= 160
        && data.targetRole is string && data.targetRole.size() <= 120
        && data.collegeOrOrg is string && data.collegeOrOrg.size() <= 120
        && data.status in ['in_progress', 'submitted']
        && (!('attemptCount' in data) || (data.attemptCount is int && data.attemptCount >= 1 && data.attemptCount <= 20))
        && data.startedAtMs is number && data.startedAtMs >= 0
        && data.submittedAtMs is number && data.submittedAtMs >= 0
        && data.timeUsedSeconds is number && data.timeUsedSeconds >= 0 && data.timeUsedSeconds <= 5400
        && data.mcqAnswers is list
        && data.mcqAnswers.size() <= 10
        && (data.mcqAnswers.size() == 0 || (data.mcqAnswers[0] is number && data.mcqAnswers[0] >= -1 && data.mcqAnswers[0] <= 3))
        && data.c1a is string && data.c1a.size() <= 1200
        && data.c1b is string && data.c1b.size() <= 1200
        && data.c1c is string && data.c1c.size() <= 1200
        && data.c2a is string && data.c2a.size() <= 1200
        && data.c2b is string && data.c2b.size() <= 1200
        && data.c2c is string && data.c2c.size() <= 1200
        && data.c3a is string && data.c3a.size() <= 1200
        && data.c3b is string && data.c3b.size() <= 1200
        && data.c3c is string && data.c3c.size() <= 1200
        && data.c4a is string && data.c4a.size() <= 1200
        && data.c4b is string && data.c4b.size() <= 1200
        && data.c4c is string && data.c4c.size() <= 1200
        && data.c5a is string && data.c5a.size() <= 1200
        && data.c5b is string && data.c5b.size() <= 1200
        && data.c5c is string && data.c5c.size() <= 1200
        && data.capstoneScare is string && data.capstoneScare.size() <= 1500
        && data.mcqScore is number && data.mcqScore >= 0 && data.mcqScore <= 400
        && data.caseScore is number && data.caseScore >= 0 && data.caseScore <= 500
        && data.scareScore is number && data.scareScore >= 0 && data.scareScore <= 100
        && data.totalXpAwarded is number && data.totalXpAwarded >= 0 && data.totalXpAwarded <= 1000
        && data.percentageScore is number && data.percentageScore >= 0 && data.percentageScore <= 100
        && data.passed is bool
        && data.gradeTier is string && data.gradeTier.size() <= 60
        && data.finalCertificateId is string && data.finalCertificateId.size() >= 4 && data.finalCertificateId.size() <= 64
        && data.lorVerificationId is string && data.lorVerificationId.size() >= 4 && data.lorVerificationId.size() <= 64
        && data.executiveFeedback is string && data.executiveFeedback.size() <= 1000
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']))
        );
      allow delete: if false;
    }

    match /connections/{connectionId} {
      allow get: if isValidId(connectionId) && isGenuineGoogleUser();
      allow list: if isGenuineGoogleUser() && existing().kind in ['concept', 'perspective', 'challenge'];
      allow create: if isValidId(connectionId)
        && isGenuineGoogleUser()
        && isValidConnectionPost(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(connectionId)
        && isGenuineGoogleUser()
        && isValidConnectionPost(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (existing().authorId == request.auth.uid || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body']);
      allow delete: if isValidId(connectionId)
        && isGenuineGoogleUser()
        && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /learnerWorkspaces/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isGenuineGoogleUser() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidLearnerWorkspace(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidLearnerWorkspace(incoming(), userId)
        && (isOwner(userId) || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'act2Pitch', 'act3StoryTitle', 'act3StoryBeats',
          'act4Observed', 'act4Missing', 'act4BeforeAfter',
          'act5CeoSolution', 'act7PitchName', 'act7PitchTagline', 'act7PitchAudience',
          'act7PitchUsps', 'act7PitchScript', 'act8Emotion', 'act8Situation',
          'act8Perspective', 'act8Response', 'act9Proposal', 'act10Theme', 'act10Notes',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /learnerProgress/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isGenuineGoogleUser() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidLearnerProgress(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidLearnerProgress(incoming(), userId)
        && (isOwner(userId) || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'xp', 'completedLevels', 'unlockedBadges',
          'wheelSpins', 'completedWheelPrompts', 'certificateId', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /advancedProgress/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isGenuineGoogleUser() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidAdvancedProgress(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidAdvancedProgress(incoming(), userId)
        && (isOwner(userId) || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'advXp', 'totalScoreSum', 'completedChallenges',
          'unlockedAdvBadges', 'advCertificateId', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /advancedSubmissions/{submissionId} {
      allow get: if isValidId(submissionId)
        && isGenuineGoogleUser()
        && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isGenuineGoogleUser()
        && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(submissionId)
        && isGenuineGoogleUser()
        && isValidAdvancedSubmission(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isValidId(submissionId)
        && isGenuineGoogleUser()
        && isValidAdvancedSubmission(incoming())
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().challengeId == existing().challengeId
        && incoming().themeId == existing().themeId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorName', 'promptUsed', 'imageDataUrl',
          'answer1', 'answer2', 'answer3', 'answer4', 'answer5',
          'scareSummary', 'totalScore', 'obsScore', 'reasonScore',
          'creativityScore', 'actionScore', 'commScore', 'feedback', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /finalAssessments/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isGenuineGoogleUser() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidFinalAssessment(incoming(), userId)
        && incoming().status == 'in_progress'
        && 'attemptCount' in incoming()
        && incoming().attemptCount == 1
        && incoming().authorEmail == request.auth.token.email
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/learnerProgress/$(userId))
        && get(/databases/$(database)/documents/learnerProgress/$(userId)).data.completedLevels.size() == 10
        && get(/databases/$(database)/documents/learnerProgress/$(userId)).data.completedWheelPrompts.size() >= 5
        && exists(/databases/$(database)/documents/advancedProgress/$(userId))
        && get(/databases/$(database)/documents/advancedProgress/$(userId)).data.completedChallenges.size() == 25;
      allow update: if isValidId(userId)
        && isValidFinalAssessment(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().authorEmail == existing().authorEmail
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && existing().status == 'in_progress'
            && incoming().startedAtMs == existing().startedAtMs
            && (
              ('attemptCount' in existing() && 'attemptCount' in incoming() && incoming().attemptCount == existing().attemptCount)
              || (!('attemptCount' in existing()) && (!('attemptCount' in incoming()) || incoming().attemptCount == 1))
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName', 'targetRole', 'collegeOrOrg', 'status', 'attemptCount',
              'submittedAtMs', 'timeUsedSeconds', 'mcqAnswers',
              'c1a', 'c1b', 'c1c', 'c2a', 'c2b', 'c2c',
              'c3a', 'c3b', 'c3c', 'c4a', 'c4b', 'c4c',
              'c5a', 'c5b', 'c5c', 'capstoneScare',
              'mcqScore', 'caseScore', 'scareScore', 'totalXpAwarded',
              'percentageScore', 'passed', 'gradeTier',
              'executiveFeedback', 'updatedAt'
            ])
          )
          || (
            isOwner(userId)
            && existing().status == 'submitted'
            && existing().passed == false
            && (!('attemptCount' in existing()) || existing().attemptCount == 1)
            && incoming().status == 'in_progress'
            && 'attemptCount' in incoming()
            && incoming().attemptCount == 2
            && incoming().startedAtMs > existing().startedAtMs
            && incoming().submittedAtMs == 0
            && incoming().timeUsedSeconds == 0
            && incoming().mcqScore == 0
            && incoming().caseScore == 0
            && incoming().scareScore == 0
            && incoming().totalXpAwarded == 0
            && incoming().percentageScore == 0
            && incoming().passed == false
            && incoming().gradeTier == ''
            && incoming().executiveFeedback == ''
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'targetRole', 'collegeOrOrg', 'status', 'attemptCount',
              'startedAtMs', 'submittedAtMs', 'timeUsedSeconds', 'mcqAnswers',
              'c1a', 'c1b', 'c1c', 'c2a', 'c2b', 'c2c',
              'c3a', 'c3b', 'c3c', 'c4a', 'c4b', 'c4c',
              'c5a', 'c5b', 'c5c', 'capstoneScare',
              'mcqScore', 'caseScore', 'scareScore', 'totalXpAwarded',
              'percentageScore', 'passed', 'gradeTier',
              'executiveFeedback', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /shoppingProgress/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isGenuineGoogleUser() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidShoppingProgress(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidShoppingProgress(incoming(), userId)
        && (isOwner(userId) || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorName', 'authorEmail', 'shopXp', 'studiedExamples',
          'answeredMcqs', 'correctMcqs', 'hintUsedMcqs', 'mcqChoices',
          'roleplayDraft', 'roleplayScore', 'roleplayFeedback',
          'unlockedShopBadges', 'shopCertificateId', 'completedModule', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /careerSkillsProgress/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isGenuineGoogleUser() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidCareerSkillsProgress(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidCareerSkillsProgress(incoming(), userId)
        && (isOwner(userId) || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorName', 'authorEmail', 'careerXp', 'studiedTopics',
          'answeredMcqs', 'correctMcqs', 'hintUsedMcqs', 'mcqChoices',
          'completedCategories', 'unlockedCareerBadges', 'careerCertificateId', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /masterSkillsProgress/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isGenuineGoogleUser() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidMasterSkillsProgress(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidMasterSkillsProgress(incoming(), userId)
        && (isOwner(userId) || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorName', 'authorEmail', 'masterXp', 'studiedPlaybooks',
          'answeredMcqs', 'correctMcqs', 'hintUsedMcqs', 'mcqChoices',
          'completedTracks', 'unlockedMasterBadges', 'masterCertificateId', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /sectionFeedback/{feedbackId} {
      allow get: if isValidId(feedbackId)
        && isGenuineGoogleUser()
        && (existing().authorId == request.auth.uid || isAdmin());
      allow list: if isGenuineGoogleUser()
        && (existing().authorId == request.auth.uid || isAdmin());
      allow create: if isValidId(feedbackId)
        && isGenuineGoogleUser()
        && isValidSectionFeedback(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().authorEmail == request.auth.token.email
        && incoming().status == 'new'
        && incoming().adminNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(feedbackId)
        && isAdmin()
        && isValidSectionFeedback(incoming())
        && incoming().authorId == existing().authorId
        && incoming().authorEmail == existing().authorEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'adminNote', 'updatedAt'
        ]);
      allow delete: if isValidId(feedbackId) && isAdmin();
    }
  }
}
