{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Verified Google-authenticated learner account for Picture Connect with Kapil.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Verified display name from Google profile."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified Google email address (PII)."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Google avatar URL."
        },
        "providerId": {
          "type": "string",
          "enum": ["google.com"],
          "description": "Sign-in provider, strictly google.com."
        },
        "role": {
          "type": "string",
          "enum": ["learner"],
          "description": "Assigned role on creation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "providerId", "role", "createdAt", "updatedAt"]
    },
    "ConnectionPost": {
      "title": "ConnectionPost",
      "description": "Shared learner submission for Central Concept, Level 1 Perspectives, or Spinning Wheel prompts.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated author UID."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Author display name."
        },
        "kind": {
          "type": "string",
          "enum": ["concept", "perspective", "challenge"],
          "description": "Submission category."
        },
        "promptRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Identifier of the picture or prompt."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Connection headline or perspective."
        },
        "body": {
          "type": "string",
          "maxLength": 600,
          "description": "Reasoning behind the connection."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["authorId", "authorName", "kind", "promptRef", "title", "body", "createdAt"]
    },
    "LearnerWorkspace": {
      "title": "LearnerWorkspace",
      "description": "Private learner response notebook across Levels 1 to 10.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated owner UID."
        },
        "act2Pitch": { "type": "string", "maxLength": 1000 },
        "act3StoryTitle": { "type": "string", "maxLength": 160 },
        "act3StoryBeats": { "type": "string", "maxLength": 1500 },
        "act4Observed": { "type": "string", "maxLength": 500 },
        "act4Missing": { "type": "string", "maxLength": 500 },
        "act4BeforeAfter": { "type": "string", "maxLength": 800 },
        "act5CeoSolution": { "type": "string", "maxLength": 1000 },
        "act7PitchName": { "type": "string", "maxLength": 120 },
        "act7PitchTagline": { "type": "string", "maxLength": 160 },
        "act7PitchAudience": { "type": "string", "maxLength": 200 },
        "act7PitchUsps": { "type": "string", "maxLength": 600 },
        "act7PitchScript": { "type": "string", "maxLength": 1000 },
        "act8Emotion": { "type": "string", "maxLength": 300 },
        "act8Situation": { "type": "string", "maxLength": 300 },
        "act8Perspective": { "type": "string", "maxLength": 300 },
        "act8Response": { "type": "string", "maxLength": 500 },
        "act9Proposal": { "type": "string", "maxLength": 1200 },
        "act10Theme": { "type": "string", "maxLength": 200 },
        "act10Notes": { "type": "string", "maxLength": 1200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "updatedAt"]
    },
    "LearnerProgress": {
      "title": "LearnerProgress",
      "description": "Gamified XP, completed Levels 1-10, unlocked achievement badges, spinning wheel stats, and certificate ID.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "xp": {
          "type": "number",
          "minimum": 0,
          "maximum": 50000
        },
        "completedLevels": {
          "type": "array",
          "items": { "type": "number" },
          "maxItems": 10
        },
        "unlockedBadges": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 20
        },
        "wheelSpins": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "completedWheelPrompts": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 50
        },
        "certificateId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "xp",
        "completedLevels",
        "unlockedBadges",
        "wheelSpins",
        "completedWheelPrompts",
        "certificateId",
        "updatedAt"
      ]
    },
    "AdvancedProgress": {
      "title": "AdvancedProgress",
      "description": "Isolated Advanced Track (AI-Powered Picture Connect) XP, completed challenge IDs, cumulative score sum, badges, and certificate ID.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "advXp": {
          "type": "number",
          "minimum": 0,
          "maximum": 25000
        },
        "totalScoreSum": {
          "type": "number",
          "minimum": 0,
          "maximum": 2500
        },
        "completedChallenges": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 25
        },
        "unlockedAdvBadges": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 15
        },
        "advCertificateId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "advXp",
        "totalScoreSum",
        "completedChallenges",
        "unlockedAdvBadges",
        "advCertificateId",
        "updatedAt"
      ]
    },
    "AdvancedSubmission": {
      "title": "AdvancedSubmission",
      "description": "Learner AI prompt, uploaded visual image, 5 structured answers, SCARE synthesis, and 100-mark auto-score breakdown for an Advanced Track challenge.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "challengeId": { "type": "string", "minLength": 1, "maxLength": 12 },
        "themeId": {
          "type": "string",
          "enum": ["products", "values", "abstract", "placements", "services"]
        },
        "promptUsed": { "type": "string", "maxLength": 1400 },
        "imageDataUrl": { "type": "string", "maxLength": 280000 },
        "answer1": { "type": "string", "maxLength": 1200 },
        "answer2": { "type": "string", "maxLength": 1200 },
        "answer3": { "type": "string", "maxLength": 1200 },
        "answer4": { "type": "string", "maxLength": 1200 },
        "answer5": { "type": "string", "maxLength": 1200 },
        "scareSummary": { "type": "string", "maxLength": 1200 },
        "totalScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "obsScore": { "type": "number", "minimum": 0, "maximum": 20 },
        "reasonScore": { "type": "number", "minimum": 0, "maximum": 25 },
        "creativityScore": { "type": "number", "minimum": 0, "maximum": 20 },
        "actionScore": { "type": "number", "minimum": 0, "maximum": 20 },
        "commScore": { "type": "number", "minimum": 0, "maximum": 15 },
        "feedback": { "type": "string", "maxLength": 800 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "authorName",
        "challengeId",
        "themeId",
        "promptUsed",
        "imageDataUrl",
        "answer1",
        "answer2",
        "answer3",
        "answer4",
        "answer5",
        "scareSummary",
        "totalScore",
        "obsScore",
        "reasonScore",
        "creativityScore",
        "actionScore",
        "commScore",
        "feedback",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Verified Google learner user accounts."
    },
    "/connections/{connectionId}": {
      "schema": { "$ref": "#/entities/ConnectionPost" },
      "description": "Shared learner perspectives, concept links, and wheel reflections."
    },
    "/learnerWorkspaces/{userId}": {
      "schema": { "$ref": "#/entities/LearnerWorkspace" },
      "description": "Personal learner responses across Levels 1-10."
    },
    "/learnerProgress/{userId}": {
      "schema": { "$ref": "#/entities/LearnerProgress" },
      "description": "Learner XP, Levels 1-10 completion, badges, and certificate credentials."
    },
    "/advancedProgress/{userId}": {
      "schema": { "$ref": "#/entities/AdvancedProgress" },
      "description": "Isolated Advanced Track progress, XP, badges, and Advanced Certificate ID."
    },
    "/advancedSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/AdvancedSubmission" },
      "description": "Per-challenge AI prompts, uploaded visual images, answers, and auto-scoring breakdowns."
    }
  }
}
