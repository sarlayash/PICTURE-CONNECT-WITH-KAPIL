    "LearnerNotification": {
      "title": "LearnerNotification",
      "description": "In-app/push missing-section reminders, section completion celebrations, admin reminders, and Gmail badge/certificate/LOR dispatch logs.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "enum": [
            "missing_reminder",
            "section_completed",
            "credential_emailed",
            "admin_reminder",
            "daily_mock_launch",
            "daily_mock_result"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": { "type": "string", "minLength": 1, "maxLength": 600 },
        "targetView": {
          "type": "string",
          "enum": [
            "journey",
            "levels",
            "wheel",
            "shopping",
            "career",
            "universe",
            "advanced",
            "final",
            "achievements",
            "profile",
            "daily_mock"
          ]
        },
        "credentialType": {
          "type": "string",
          "enum": [
            "",
            "badge",
            "certificate",
            "lor",
            "reminder_digest",
            "daily_mock_invite",
            "daily_mock_summary"
          ]
        },
        "channel": {
          "type": "string",
          "enum": ["in_app", "push", "email", "push_and_email"]
        },
        "read": { "type": "boolean" },
        "sentBy": {
          "type": "string",
          "enum": ["system", "learner", "admin"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "recipientEmail",
        "kind",
        "title",
        "body",
        "targetView",
        "credentialType",
        "channel",
        "read",
        "sentBy",
        "createdAt"
      ]
    },
    "DailyMockAttempt": {
      "title": "DailyMockAttempt",
      "description": "Daily 60-minute timed Mock Test attempt (40 MCQs, 50% Hard across all portal topics) with auto-saved answers, graded topic summary, and email summary tracking.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "authorEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "paperCode": { "type": "string", "minLength": 4, "maxLength": 40 },
        "status": {
          "type": "string",
          "enum": ["in_progress", "submitted"]
        },
        "startedAtMs": { "type": "number", "minimum": 0 },
        "submittedAtMs": { "type": "number", "minimum": 0 },
        "timeUsedSeconds": { "type": "number", "minimum": 0, "maximum": 3600 },
        "answers": {
          "type": "array",
          "items": { "type": "number" },
          "maxItems": 40
        },
        "flaggedIndices": {
          "type": "array",
          "items": { "type": "number" },
          "maxItems": 40
        },
        "totalQuestions": { "type": "integer", "minimum": 1, "maximum": 40 },
        "hardQuestionCount": { "type": "integer", "minimum": 1, "maximum": 40 },
        "answeredCount": { "type": "integer", "minimum": 0, "maximum": 40 },
        "correctCount": { "type": "integer", "minimum": 0, "maximum": 40 },
        "hardCorrectCount": { "type": "integer", "minimum": 0, "maximum": 40 },
        "standardCorrectCount": { "type": "integer", "minimum": 0, "maximum": 40 },
        "scorePercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "hardAccuracyPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "passed": { "type": "boolean" },
        "gradeLabel": { "type": "string", "maxLength": 40 },
        "xpAwarded": { "type": "integer", "minimum": 0, "maximum": 500 },
        "topicSummary": { "type": "string", "maxLength": 800 },
        "weakestTopic": { "type": "string", "maxLength": 80 },
        "strongestTopic": { "type": "string", "maxLength": 80 },
        "resultEmailed": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "authorName",
        "authorEmail",
        "dateKey",
        "paperCode",
        "status",
        "startedAtMs",
        "submittedAtMs",
        "timeUsedSeconds",
        "answers",
        "flaggedIndices",
        "totalQuestions",
        "hardQuestionCount",
        "answeredCount",
        "correctCount",
        "hardCorrectCount",
        "standardCorrectCount",
        "scorePercent",
        "hardAccuracyPercent",
        "passed",
        "gradeLabel",
        "xpAwarded",
        "topicSummary",
        "weakestTopic",
        "strongestTopic",
        "resultEmailed",
        "updatedAt"
      ]
    },
    "AdminDistributionList": {
      "title": "AdminDistributionList",
      "description": "Reusable admin-curated email distribution list containing only verified registered learner UIDs and sign-up email IDs.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "recipientUids": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 250
        },
        "recipientEmails": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 250
        },
        "lastSentAtMs": { "type": "number", "minimum": 0 },
        "sentCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "createdByEmail",
        "name",
        "description",
        "recipientUids",
        "recipientEmails",
        "lastSentAtMs",
        "sentCount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Verified Google learner user accounts with My Profile details and notification preferences."
    },
    "/connections/{connectionId}": {
      "schema": { "$ref": "#/entities/ConnectionPost" },
      "description": "Shared learner perspectives, concept links, and wheel reflections."
    },
    "/learnerWorkspaces/{userId}": {
      "schema": { "$ref": "#/entities/LearnerWorkspace" },
      "description": "Personal learner responses across Levels 1-10."
    },
    "/learnerProgress/{userId}": {
      "schema": { "$ref": "#/entities/LearnerProgress" },
      "description": "Learner XP, Levels 1-10 completion, badges, and certificate credentials."
    },
    "/advancedProgress/{userId}": {
      "schema": { "$ref": "#/entities/AdvancedProgress" },
      "description": "Isolated Advanced Track progress, XP, badges, and Advanced Certificate ID."
    },
    "/advancedSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/AdvancedSubmission" },
      "description": "Per-challenge AI prompts, uploaded visual images, answers, and auto-scoring breakdowns."
    },
    "/finalAssessments/{userId}": {
      "schema": { "$ref": "#/entities/FinalAssessment" },
      "description": "1000 XP, 90-minute proctored Final Assessment sessions, scores, and issued Certificate/LOR IDs."
    },
    "/shoppingProgress/{userId}": {
      "schema": { "$ref": "#/entities/ShoppingProgress" },
      "description": "Shopping & Negotiation Skills solved examples, hinted MCQs, roleplay score, XP, badges, and Certificate ID."
    },
    "/careerSkillsProgress/{userId}": {
      "schema": { "$ref": "#/entities/CareerSkillsProgress" },
      "description": "Indianism, Interview Skills, and GD Skills study playbooks, 45 graded MCQs, XP, badges, and Certificate ID."
    },
    "/masterSkillsProgress/{userId}": {
      "schema": { "$ref": "#/entities/MasterSkillsProgress" },
      "description": "16-track Master Universe progress (Aptitude, Grammar, Parts of Speech, Parts of Grammar, Tenses, Punctuation, Idioms, C, C++, Java, Python, DSA, Excel, Power BI, DBMS, Cloud Computing) with 96 playbooks, 160 graded MCQs, XP, 10 badges, and Certificate ID."
    },
    "/sectionFeedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/SectionFeedback" },
      "description": "Learner ratings, highlights, and improvement suggestions submitted per section for Mentor Kapil's Admin Feedback Reports."
    },
    "/learnerNotifications/{notificationId}": {
      "schema": { "$ref": "#/entities/LearnerNotification" },
      "description": "Push/in-app section reminders, daily mock alerts, completion celebrations, admin reminders, and Gmail dispatch logs."
    },
    "/dailyMockAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/DailyMockAttempt" },
      "description": "Daily 60-minute timed Mock Test sessions (40 MCQs, 50% Hard across all portal topics) keyed as {uid}_{YYYY-MM-DD}."
    },
    "/adminDistributionLists/{listId}": {
      "schema": { "$ref": "#/entities/AdminDistributionList" },
      "description": "Admin-managed reusable email distribution lists restricted to verified registered learners."
    }
  }
}
