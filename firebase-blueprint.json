{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Verified Google-authenticated learner account for Picture Connect with Kapil.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Verified display name from Google profile."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified Google email address (PII)."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Google avatar URL."
        },
        "customPhotoDataUrl": {
          "type": "string",
          "maxLength": 140000,
          "description": "Compressed 256x256 JPEG data URL uploaded by the learner under My Profile."
        },
        "linkedinId": {
          "type": "string",
          "maxLength": 160,
          "description": "Learner LinkedIn handle or profile URL."
        },
        "githubId": {
          "type": "string",
          "maxLength": 160,
          "description": "Learner GitHub username or profile URL."
        },
        "mobileNumber": {
          "type": "string",
          "maxLength": 25,
          "description": "Learner mobile contact number (PII, owner/admin only)."
        },
        "college": {
          "type": "string",
          "maxLength": 160,
          "description": "Learner college, university, or organization name."
        },
        "areaOfInterest": {
          "type": "string",
          "maxLength": 200,
          "description": "Comma-separated learner areas of interest."
        },
        "domain": {
          "type": "string",
          "maxLength": 100,
          "description": "Primary career or technical domain."
        },
        "pushEnabled": {
          "type": "boolean",
          "description": "Whether browser push notifications for missing and completed sections are enabled."
        },
        "reminderFrequency": {
          "type": "string",
          "enum": ["daily", "every_3_days", "weekly", "off"],
          "description": "Preferred cadence for section completion reminders."
        },
        "emailRemindersEnabled": {
          "type": "boolean",
          "description": "Whether learner opted in for email digest reminders to sign-up email."
        },
        "lastReminderAtMs": {
          "type": "number",
          "minimum": 0,
          "description": "Epoch milliseconds of the last delivered section reminder."
        },
        "providerId": {
          "type": "string",
          "enum": ["google.com"],
          "description": "Sign-in provider, strictly google.com."
        },
        "role": {
          "type": "string",
          "enum": ["learner"],
          "description": "Assigned role on creation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "providerId", "role", "createdAt", "updatedAt"]
    },
    "ConnectionPost": {
      "title": "ConnectionPost",
      "description": "Shared learner submission for Central Concept, Level 1 Perspectives, or Spinning Wheel prompts.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated author UID."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Author display name."
        },
        "kind": {
          "type": "string",
          "enum": ["concept", "perspective", "challenge"],
          "description": "Submission category."
        },
        "promptRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Identifier of the picture or prompt."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Connection headline or perspective."
        },
        "body": {
          "type": "string",
          "maxLength": 600,
          "description": "Reasoning behind the connection."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["authorId", "authorName", "kind", "promptRef", "title", "body", "createdAt"]
    },
